{
  "model": "sonnet",
  "remoteControlAtStartup": true,
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "enabledPlugins": {
    "ci-self-iteration@rover-plugins": true,
    "owner-retention@rover-plugins": true,
    "rover-mode@rover-plugins": true
  },
  "permissions": {
    "allow": [
      "Bash(./bin/makemessages.sh:*)",
      "Bash(./bin/remote-makemessages.sh:*)",
      "Bash(bin/makemessages.sh:*)",
      "Bash(bin/remote-makemessages.sh:*)",
      "Bash(m generate_api_schemas:*)",
      "Bash(m makemessages:*)",
      "Bash(pnpm build:apiClient:*)",
      "mcp__gateway__portal_codemode_execute"
    ]
  }
}
