{
  "name": "codespace-keepalive",
  "displayName": "Codespace Keep-Alive (personal)",
  "description": "During working hours, types into a hidden terminal and saves a scratch file outside any repo so the codespace idle timeout does not fire.",
  "publisher": "sergigarreta",
  "version": "0.1.1",
  "private": true,
  "license": "UNLICENSED",
  "engines": { "vscode": "^1.94.0" },
  "extensionKind": ["workspace"],
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      { "command": "codespaceKeepAlive.pingNow", "title": "Codespace Keep-Alive: Ping Now" },
      { "command": "codespaceKeepAlive.toggle", "title": "Codespace Keep-Alive: Toggle" },
      { "command": "codespaceKeepAlive.showLog", "title": "Codespace Keep-Alive: Show Log" }
    ],
    "configuration": {
      "title": "Codespace Keep-Alive",
      "properties": {
        "codespaceKeepAlive.enabled": { "type": "boolean", "default": true },
        "codespaceKeepAlive.timeZone": { "type": "string", "default": "UTC", "description": "IANA time zone the working hours are in, e.g. Europe/Madrid." },
        "codespaceKeepAlive.startHour": { "type": "integer", "default": 9, "minimum": 0, "maximum": 23 },
        "codespaceKeepAlive.endHour": { "type": "integer", "default": 17, "minimum": 1, "maximum": 24, "description": "Pings stop at this hour (exclusive)." },
        "codespaceKeepAlive.weekdaysOnly": { "type": "boolean", "default": true },
        "codespaceKeepAlive.intervalMinutes": { "type": "integer", "default": 20, "minimum": 1, "description": "Keep well below the codespace idle timeout." }
      }
    }
  }
}
